import subprocess
import time
import ctypes
from pywinauto import Desktop

RADMIN_EXE = r"C:\Program Files (x86)\Radmin VPN\RvRvpnGui.exe"

WINDOW_TITLE = "Radmin VPN"
MAIN_WINDOW_CLASS = "CMainWnd"

POWER_ID = (
    "MainWindow.centralWidget.mainContentWidget."
    "userInfoWidget.BPower"
)

STATUS_ID = (
    "MainWindow.centralWidget.mainContentWidget."
    "userInfoWidget.LStatus"
)

START_TIMEOUT = 60
CONNECT_TIMEOUT = 30

def find_element(root, automation_id):

    try:
        if root.element_info.automation_id == automation_id:
            return root
    except Exception:
        pass

    try:
        children = root.children()
    except Exception:
        return None

    for child in children:

        result = find_element(child, automation_id)

        if result:
            return result

    return None

def get_radmin_windows():

    try:

        desktop = Desktop(backend="uia")

        return desktop.windows(
            title=WINDOW_TITLE,
            top_level_only=True
        )

    except Exception:

        return []

def window_info(window):

    try:
        hwnd = window.handle
    except Exception:
        hwnd = 0

    try:
        pid = window.process_id()
    except Exception:
        pid = -1

    try:
        cls = window.class_name()
    except Exception:
        cls = "?"

    try:
        title = window.window_text()
    except Exception:
        title = "?"

    return hwnd, pid, cls, title

def start_radmin():

    print("Запускаем Radmin VPN...")

    try:

        process = subprocess.Popen(
            [RADMIN_EXE],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,

            # Не создаём консоль для Radmin
            creationflags=0x08000000
        )

        print(f"Процесс запущен. PID = {process.pid}")

        return process

    except Exception as e:

        print()
        print("ОШИБКА запуска Radmin:")
        print(e)

        return None

def wait_for_main_window():

    print()
    print("Ищем главное окно Radmin VPN...")
    print("(CMainWnd + BPower)")

    start_time = time.time()

    seen = set()

    while time.time() - start_time < START_TIMEOUT:

        windows = get_radmin_windows()

        for window in windows:

            try:

                hwnd, pid, cls, title = window_info(window)

            except Exception:

                continue

            # -----------------------------------------------
            # Показываем информацию о новых HWND
            # -----------------------------------------------

            if hwnd not in seen:

                seen.add(hwnd)

                print()
                print("Новое окно Radmin:")
                print(f"  HWND = 0x{hwnd:X}")
                print(f"  PID  = {pid}")
                print(f"  CLASS = {cls}")
                print(f"  TITLE = {title}")

            # -----------------------------------------------
            # CToastContainer сразу пропускаем
            # -----------------------------------------------

            if cls != MAIN_WINDOW_CLASS:

                continue

            print()
            print("Найдено главное окно CMainWnd.")

            # -----------------------------------------------
            # Проверяем BPower
            # -----------------------------------------------

            try:

                power = find_element(
                    window,
                    POWER_ID
                )

                if power:

                    print()
                    print("================================")
                    print("НАЙДЕНО ПРАВИЛЬНОЕ ОКНО")
                    print("================================")
                    print(f"HWND = 0x{hwnd:X}")
                    print(f"PID  = {pid}")
                    print(f"CLASS = {cls}")
                    print("BPower найден!")

                    return window

            except Exception:

                pass

        time.sleep(0.15)

    return None

def hide_window(window):

    try:

        hwnd = window.handle

        print()
        print(f"Скрываем окно HWND = 0x{hwnd:X}")

        # SW_HIDE
        ctypes.windll.user32.ShowWindow(
            hwnd,
            0
        )

        print("Окно скрыто.")

        return True

    except Exception as e:

        print()
        print("Не удалось скрыть окно:")
        print(e)

        return False

def connect_radmin(window):

    print()
    print("Ждём интерфейс Radmin...")

    start_time = time.time()

    power = None
    status = None

    while time.time() - start_time < 20:

        try:

            power = find_element(
                window,
                POWER_ID
            )

            status = find_element(
                window,
                STATUS_ID
            )

            if power and status:
                break

        except Exception:

            pass

        time.sleep(0.2)

    if not power:

        print()
        print("ОШИБКА: BPower не найден.")

        return False

    if not status:

        print()
        print("ОШИБКА: LStatus не найден.")

        return False

    print()
    print("Power найден.")
    print("ControlType:", power.element_info.control_type)
    print("AutomationId:", power.element_info.automation_id)

    print("Status найден.")
    try:
        state = power.get_toggle_state()
    except Exception:
        state = -1

    try:
        status_text = status.window_text()
    except Exception:
        status_text = ""

    print()
    print("State before:", state)
    print("Status before:", status_text)

    if status_text in (
        "В сети",
        "Онлайн",
        "Подключено"
    ):

        print()
        print("Radmin VPN уже подключён.")

        return True

    if status_text == "Подключение...":

        print()
        print("Radmin уже подключается.")

    else:

        print()
        print("Radmin VPN выключен.")
        print("Включаем...")

        try:

            print("Пробуем UIA invoke()...")

            power.invoke()

            print("invoke() выполнен.")

        except Exception as e:

            print("invoke() не сработал:")
            print(e)

            try:

                print("Пробуем click_input()...")

                power.click_input()

                print("click_input() выполнен.")

            except Exception as e2:

                print("click_input() тоже не сработал:")
                print(e2)

                return False


    print()
    print("Ожидаем подключения...")

    start_time = time.time()

    last_status = None

    while time.time() - start_time < CONNECT_TIMEOUT:

        try:
            current_status = status.window_text()
        except Exception:
            current_status = ""

        try:
            current_state = power.get_toggle_state()
        except Exception:
            current_state = -1

        # Выводим только изменения
        if current_status != last_status:

            print(
                f"State = {current_state}, "
                f"Status = {current_status}"
            )

            last_status = current_status
        if current_status in (
            "В сети",
            "Онлайн",
            "Подключено"
        ):
            print("SUCCESS")
            print("Radmin VPN подключён.")

            return True

        time.sleep(0.25)

    print("ОШИБКА: подключение не завершилось.")

    return False

def main():
    process = start_radmin()

    if not process:

        return
    window = wait_for_main_window()

    if not window:
        print("ОШИБКА")
        print("CMainWnd с BPower не найден.")
        return

    hide_window(window)

    success = connect_radmin(window)

    if success:

        print("ГОТОВО")
        print("VPN подключён.")
        print("Окно скрыто.")

    else:

        print()
        print("Подключение не удалось.")
        print("Окно оставлено запущенным.")


if __name__ == "__main__":
    main()
